---
/**
 * Curva dosis-respuesta de la proteína.
 *
 * ES UN ESQUEMA, no una reproducción de las gráficas originales: dibuja la
 * forma que describen Morton (2018) —las ganancias dejan de aumentar hacia
 * 1,6 g/kg— y Tagawa (2020) —la pendiente es mucho mayor por debajo de
 * 1,3 g/kg—. El pie de figura lo dice, para no dar a entender que son datos
 * medidos punto por punto.
 *
 * SVG en línea y no imagen: pesa poco, se ve nítido en cualquier pantalla y
 * usa los colores del tema, así que acompaña al modo oscuro sin trucos.
 */
const MIN = 0.8,
  MAX = 2.4;
const ANCHO = 480,
  ALTO = 260;
const IZQ = 46,
  DER = 456,
  ARRIBA = 34,
  ABAJO = 208;

// Pares [g/kg, ganancia relativa 0-100] que describen la forma de la curva.
const curva: [number, number][] = [
  [0.8, 8], [1.0, 30], [1.2, 54], [1.3, 68], [1.4, 79],
  [1.5, 88], [1.6, 95], [1.8, 97], [2.0, 98], [2.2, 99], [2.4, 99],
];
const x = (g: number) => IZQ + ((g - MIN) / (MAX - MIN)) * (DER - IZQ);
const y = (v: number) => ABAJO - (v / 100) * (ABAJO - ARRIBA);
const puntos = curva.map(([g, v]) => `${x(g).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
const area = `${x(MIN)},${ABAJO} ${puntos} ${x(MAX)},${ABAJO}`;

const marcas = [
  { g: 1.2, etq: '1,2', pie: 'mínimo' },
  { g: 1.6, etq: '1,6', pie: 'referencia' },
  { g: 2.0, etq: '2,0', pie: 'máximo' },
];
---

<figure class="figura">
  <svg
    viewBox={`0 0 ${ANCHO} ${ALTO}`}
    role="img"
    aria-labelledby="gp-titulo gp-desc"
    class="figura-svg"
  >
    <title id="gp-titulo">Ganancia de músculo según los gramos de proteína por kilo</title>
    <desc id="gp-desc">
      La curva sube con fuerza hasta 1,3 gramos por kilo, sigue subiendo más despacio hasta 1,6 y
      a partir de ahí se aplana: comer más proteína ya no añade ganancias.
    </desc>

    <line x1={IZQ} y1={ABAJO} x2={DER} y2={ABAJO} stroke="var(--border2)" stroke-width="1"></line>
    <line x1={IZQ} y1={ARRIBA} x2={IZQ} y2={ABAJO} stroke="var(--border2)" stroke-width="1"></line>

    <polygon points={area} fill="var(--lime-deep)"></polygon>
    <polyline points={puntos} fill="none" stroke="var(--lime)" stroke-width="3"
      stroke-linejoin="round" stroke-linecap="round"></polyline>

    {
      marcas.map((m) => (
        <>
          <line x1={x(m.g)} y1={ARRIBA} x2={x(m.g)} y2={ABAJO}
            stroke="var(--border2)" stroke-width="1" stroke-dasharray="3 4" />
          <circle cx={x(m.g)} cy={y(curva.find((c) => c[0] === m.g)![1])} r="5"
            fill="var(--bg)" stroke="var(--lime)" stroke-width="3" />
          <text x={x(m.g)} y={ABAJO + 20} text-anchor="middle" font-size="13"
            fill="var(--text)" font-weight="600">{m.etq}</text>
          <text x={x(m.g)} y={ABAJO + 36} text-anchor="middle" font-size="11"
            fill="var(--text2)">{m.pie}</text>
        </>
      ))
    }

    <text x={IZQ} y={ARRIBA - 12} font-size="12" fill="var(--text2)">Ganancia de músculo</text>
    <text x={DER} y={ABAJO - 10} text-anchor="end" font-size="12" fill="var(--text2)">
      se aplana
    </text>
  </svg>
  <figcaption class="figura-pie">
    Gramos de proteína por kilo de peso al día. <strong>Esquema</strong> elaborado a partir de los
    resultados de Morton et&nbsp;al. (2018) y Tagawa et&nbsp;al. (2020); no reproduce sus gráficas
    originales punto por punto.
  </figcaption>
</figure>
