---
import { SITE } from '../config/site';

// Se muestra solo si algún dato del titular sigue sin rellenar.
// Es una red de seguridad: evita publicar un aviso legal con huecos,
// que ante una inspección es igual de inválido que no tenerlo.
const pendientes = Object.entries(SITE.titular)
  .filter(([, valor]) => valor.startsWith('PENDIENTE'))
  .map(([campo]) => campo);
---

{
  pendientes.length > 0 && (
    <div class="aviso-pendiente">
      <strong>⚠️ Datos legales sin rellenar:</strong> {pendientes.join(', ')}. Edita
      <code>src/config/site.ts</code> antes de publicar. Este aviso desaparece solo cuando
      no quede ningún campo pendiente.
    </div>
  )
}
