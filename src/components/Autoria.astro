---
/**
 * Firma de autor y fecha de actualización de una guía.
 *
 * Existe porque, tras la denegación de AdSense de septiembre de 2026, se midió
 * que 0 de 17 guías mostraban quién las escribe ni cuándo se revisaron, y las
 * pautas de Google sobre contenido útil piden ambas cosas de forma visible.
 * La fecha debe coincidir con `dateModified` del schema Article de la guía.
 */
import { SITE } from '../config/site';

interface Props {
  /** Fecha ISO (AAAA-MM-DD) de la última revisión real del contenido. */
  actualizado: string;
}

const { actualizado } = Astro.props;
const fecha = new Date(`${actualizado}T12:00:00Z`).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<div class="autoria">
  <p class="autoria-linea">
    Por <a href="/sobre-nosotros">{SITE.titular.nombre}</a> · Actualizado el{' '}
    <time datetime={actualizado}>{fecha}</time>
  </p>
  <p class="autoria-nota">
    Basada en estudios y revisiones científicas publicadas. Cada afirmación importante enlaza a
    su fuente, y la lista completa está al final, en <a href="#fuentes">Fuentes</a>.
  </p>
</div>
