---
import Base from '../../layouts/Base.astro';
import Autoria from '../../components/Autoria.astro';
import Fuentes, { type Fuente } from '../../components/Fuentes.astro';
import { SITE } from '../../config/site';

// La tabla se genera con los mismos coeficientes que usa la calculadora.
// Escribirla a mano garantizaría que algún día deje de coincidir.
const ACTUALIZADO = '2026-09-15';

const S = {
  morton: 'https://pubmed.ncbi.nlm.nih.gov/28698222/',
  tagawa: 'https://pubmed.ncbi.nlm.nih.gov/33300582/',
  acsm: 'https://www.dietitians.ca/DietitiansOfCanada/media/Documents/Resources/noap-position-paper.pdf?ext=.pdf',
  issn: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5477153/',
};

const fuentes: Fuente[] = [
  { autores: 'Thomas DT, Erdman KA, Burke LM', anio: 2016, titulo: 'Nutrition and Athletic Performance. Joint position of the Academy of Nutrition and Dietetics, Dietitians of Canada and the American College of Sports Medicine', publicacion: 'Medicine & Science in Sports & Exercise (texto publicado por Dietitians of Canada)', url: S.acsm },
  { autores: 'Morton RW, et al.', anio: 2018, titulo: 'A systematic review, meta-analysis and meta-regression of the effect of protein supplementation on resistance training-induced gains in muscle mass and strength in healthy adults', publicacion: 'British Journal of Sports Medicine', url: S.morton },
  { autores: 'Tagawa R, et al.', anio: 2020, titulo: 'Dose-response relationship between protein intake and muscle mass increase: a systematic review and meta-analysis of randomized controlled trials', publicacion: 'Nutrition Reviews', url: S.tagawa },
  { autores: 'Jäger R, et al.', anio: 2017, titulo: 'International Society of Sports Nutrition Position Stand: protein and exercise', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.issn },
];

const PESOS = [60, 70, 80, 90, 100];
// Sustituye al reparto anterior, que bajaba la proteína al subir la actividad.
// Ahora son los tres puntos del rango oficial del ACSM (2016).
const PERFILES = [
  { nombre: 'Mínimo del rango · si no entrenas fuerza', gkg: 1.2 },
  { nombre: 'Referencia si entrenas para ganar músculo', gkg: 1.6 },
  { nombre: 'Máximo del rango · si te sienta mejor así', gkg: 2.0 },
];

const faq = [
  {
    p: '¿Cuánta proteína necesito si peso 70 kilos?',
    r: 'Entre 84 y 140 g al día. El ACSM y las asociaciones de dietistas de Estados Unidos y Canadá (2016) sitúan a los deportistas entre 1,2 y 2,0 g por kilo, lo que para 70 kg son de 84 a 140 g. Si entrenas para ganar músculo, la referencia son 112 g (1,6 g/kg): es donde el metaanálisis de Morton (2018) encontró que dejan de aumentar las ganancias.',
  },
  {
    p: '¿Es mejor repartir la proteína en varias comidas?',
    r: 'Sí. Lo ideal son tres comidas al día, aunque con dos también funciona. Repartirla permite aprovecharla mejor: el cuerpo tiene un límite de proteína que puede destinar a construir músculo en una sola toma, así que 100 g de golpe no rinden lo mismo que repartidos. Además, comidas más repartidas sientan mejor y facilitan cuadrar los carbohidratos.',
  },
  {
    p: '¿Hace falta tomar proteína en polvo?',
    r: 'No es imprescindible: si llegas a tu objetivo con comida real, mejor. Dicho eso, es muy útil en desayunos y meriendas, donde cuesta meter proteína sin recurrir a preparaciones dulces. Mezclada con avena, cereales o crema de arroz, cuadra el reparto de macros de una comida que normalmente no aporta proteína. Y en definición ayuda mucho a quitar el antojo de dulce.',
  },
  {
    p: '¿Más proteína me hará ganar más músculo?',
    r: 'No. Pasado cierto punto, subir la proteína no aporta más músculo ni lo protege mejor. Lo que preserva la masa muscular durante una definición es el entrenamiento: mantener o mejorar las cargas. Y si subes la proteína quitando carbohidratos, empeoras justo eso, porque te quedas sin combustible para entrenar fuerte.',
  },
  {
    p: '¿Los carbohidratos engordan?',
    r: 'No. Lo que engorda es un superávit calórico mantenido en el tiempo, vengan las calorías de donde vengan. Si comes 2.300 kcal y gastas 2.500, no vas a engordar aunque la mayor parte sean carbohidratos. Y si haces deporte, son la fuente de energía que más te conviene: no los elimines.',
  },
  {
    p: '¿Tengo que pesar la comida?',
    r: 'Si quieres calcular de verdad lo que comes, sí. Calcular a ojo es la forma más habitual de creer que estás en déficit cuando no lo estás. Basta con una báscula de cocina y mirar la etiqueta o buscar el alimento con los gramos que has pesado.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Cuánta proteína necesito al día',
    description:
      'Cuántos gramos de proteína necesitas según tu peso y tu nivel de actividad, cómo repartirla en el día y de qué alimentos sacarla.',
    inLanguage: 'es-ES',
    author: { '@id': `${SITE.url}/#persona` },
    publisher: { '@id': `${SITE.url}/#persona` },
    mainEntityOfPage: `${SITE.url}/guias/cuanta-proteina-necesito-al-dia`,
    dateModified: ACTUALIZADO,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE.url}/guias` },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Cuánta proteína necesito al día',
        item: `${SITE.url}/guias/cuanta-proteina-necesito-al-dia`,
      },
    ],
  },
];
---

<Base
  title="Cuánta Proteína Necesito al Día Según mi Peso"
  description="Cuántos gramos de proteína al día necesitas según tu peso y actividad, con tabla para 60, 70, 80, 90 y 100 kg. Cómo repartirla y de dónde sacarla."
  schema={schema}
>
  <div class="hero hero-sm">
    <div class="hero-glow"></div>
    <div class="site-badge">Guía</div>
    <h1>Cuánta proteína necesito al día</h1>
    <p class="hero-sub">
      Tu número exacto según lo que pesas y lo que entrenas — y por qué probablemente sea
      menos de lo que te han dicho.
    </p>
  </div>

  <main id="contenido">
    <div class="wrap">
      <div class="content-section" style="border-top:none;padding-top:2.5rem">
        <Autoria actualizado={ACTUALIZADO} />
        <p class="cs-text">
          La respuesta corta: <strong>entre 1,2 y 2,0 gramos por kilo de peso corporal</strong>,
          según el <a href={S.acsm} target="_blank" rel="noopener">ACSM y las asociaciones de
          dietistas de Estados Unidos y Canadá (2016)</a>. Y si entrenas para ganar músculo, la
          referencia son <strong>1,6 g/kg</strong>.
        </p>
        <p class="cs-text">
          Lo interesante no es el número, sino lo que hay detrás: <strong>más proteína no es
          mejor indefinidamente</strong>, y pasarse tiene un coste que casi nadie cuenta.
          Primero tu cifra, luego el porqué.
        </p>
      </div>

      <!-- ─────────── LA TABLA ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Tu número</div>
        <h2 class="cs-title">Gramos de proteína al día según tu peso</h2>
        <p class="cs-text">
          Busca tu peso. Estas son las tres referencias del rango, y las que usa la
          <a href="/" style="color:var(--lime)">calculadora de macros</a>, que parte de 1,6 g/kg y
          te deja ajustarlo:
        </p>

        <table class="tabla-legal">
          <thead>
            <tr>
              <th>Perfil</th>
              {PESOS.map((p) => <th>{p} kg</th>)}
            </tr>
          </thead>
          <tbody>
            {
              PERFILES.map((perfil) => (
                <tr>
                  <td>
                    {perfil.nombre}
                    <br />
                    <span style="color:var(--muted);font-size:0.85em">
                      {perfil.gkg.toFixed(1).replace('.', ',')} g/kg
                    </span>
                  </td>
                  {PESOS.map((p) => (
                    <td><strong>{Math.round(p * perfil.gkg)} g</strong></td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>

        <p class="cs-text">
          ¿No sabes cuál elegir? Quédate con 1,6 g/kg. La
          <a href="/" style="color:var(--lime)">calculadora</a> parte de ahí, te da las calorías y
          el resto de macros, y puedes subir o bajar la proteína con un deslizador: lo que sube en
          proteína baja en carbohidratos, sin cambiar las calorías.
        </p>
      </div>

      <!-- ─────────── POR QUÉ BAJA ─────────── -->
      <div class="content-section">
        <div class="cs-tag">El porqué</div>
        <h2 class="cs-title">Por qué 1,6 y no 2 gramos por kilo</h2>

        <div class="antes-ahora">
          <div class="aa-antes">
            <div class="aa-etq">Lo que se repetía en el gimnasio</div>
            <p>Que hacían falta 2 g por kilo como mínimo, y que cuanta más proteína, mejor.</p>
          </div>
          <div class="aa-ahora">
            <div class="aa-etq">Lo que muestran los estudios</div>
            <p>
              Casi todo el beneficio llega antes. Según <a href={S.tagawa} target="_blank" rel="noopener">Tagawa
              et al. (2020)</a>, cada 0,1 g/kg más se asoció con +0,39 kg de masa magra por debajo
              de 1,3 g/kg al día, y solo con +0,12 kg por encima. Y
              <a href={S.morton} target="_blank" rel="noopener">Morton et al. (2018)</a>, con 49
              estudios y 1.863 personas, no encontró más ganancias pasados los 1,6 g/kg.
            </p>
          </div>
        </div>

        <p class="cs-text">
          Que no sume más no significa que perjudique: por encima de 1,6 g/kg simplemente deja de
          aportar. Pero sí tiene un coste indirecto, y es la parte que conviene explicar bien.
        </p>
        <p class="cs-text">
          <strong>Lo que preserva tu músculo durante una definición no es la proteína: es el
          entrenamiento.</strong> Es el estímulo de mover cargas exigentes lo que le dice a tu
          cuerpo que ese músculo hace falta. Y para mover esas cargas necesitas glucógeno, que
          viene de los carbohidratos.
        </p>
        <div class="cs-highlight">
          <strong>El error clásico:</strong> llega la definición, se recortan calorías, se
          sube la proteína «por si acaso» y el recorte sale entero de los carbohidratos. Dos
          semanas después el rendimiento se ha desplomado, ya no se mueven las cargas de antes
          — y ahí sí empieza a perderse músculo. No por falta de proteína, sino porque los
          entrenamientos ya no justifican mantenerlo.
        </div>
        <p class="cs-text">
          Cada gramo de proteína que añades por encima de lo necesario es un gramo de
          carbohidrato que quitas. Y ese carbohidrato es el que sostiene el entrenamiento que
          de verdad te protege.
        </p>
        <p class="cs-text">
          Por eso la calculadora parte de 1,6 g/kg y te deja moverlo entre 1,2 y 2,0: dentro de
          ese rango la decisión es tuya. La <a href={S.issn} target="_blank" rel="noopener">ISSN
          (2017)</a> lo sitúa entre 1,4 y 2,0 g/kg. Tienes el planteamiento completo en
          <a href="/metodo" style="color:var(--lime)">Nuestro método</a>.
        </p>
      </div>

      <!-- ─────────── REPARTO ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Cómo repartirla</div>
        <h2 class="cs-title">Tres comidas, mejor que una atracón</h2>
        <p class="cs-text">
          El total del día es lo que más pesa, pero el reparto también cuenta.
          <strong>Lo ideal son tres comidas</strong>; con dos también se puede, sin drama.
        </p>
        <p class="cs-text">
          El motivo es que <strong>el cuerpo tiene un límite de proteína que puede destinar a
          construir músculo en una sola toma</strong>. Meterte 100 gramos de golpe en una
          comida no rinde igual que repartirlos: buena parte se acaba usando como energía en
          lugar de para reparar tejido.
        </p>
        <p class="cs-text">
          Repartir tiene además dos ventajas prácticas: las digestiones son más ligeras y
          resulta mucho más fácil cuadrar los carbohidratos alrededor del entrenamiento.
        </p>
      </div>

      <!-- ─────────── ALIMENTOS ─────────── -->
      <div class="content-section">
        <div class="cs-tag">De dónde sacarla</div>
        <h2 class="cs-title">Los alimentos que uso yo</h2>
        <p class="cs-text">
          Sin listas de manual. Esto es lo que hay en mi compra habitual:
        </p>
        <ul style="padding-left:1.2rem;margin-bottom:1rem">
          <li class="cs-text" style="margin-bottom:0.4rem">Pechuga de pollo y de pavo</li>
          <li class="cs-text" style="margin-bottom:0.4rem">Filetes de ternera y carne roja</li>
          <li class="cs-text" style="margin-bottom:0.4rem">Pescado, sobre todo blanco</li>
        </ul>
        <p class="cs-text">
          Con eso, llegar al objetivo de proteína es sencillo en comida y cena. El problema
          suele estar en otro sitio.
        </p>

        <h3 class="cs-h3">Dónde encaja la proteína en polvo</h3>
        <p class="cs-text">
          <strong>Si llegas con comida real, mejor.</strong> Pero hay dos momentos del día
          donde cuesta mucho: el <strong>desayuno</strong> y la <strong>merienda</strong>,
          porque suelen ser comidas dulces que no aportan apenas proteína.
        </p>
        <p class="cs-text">
          Ahí sí uso whey: mezclada con avena, con cereales o con crema de arroz. Cuadra el
          reparto de macros de una comida que de otro modo sería casi solo carbohidrato. Y
          <strong>en definición ayuda muchísimo a quitar el antojo de dulce</strong>, que es
          donde mucha gente se cae.
        </p>
        <div class="cs-highlight">
          <strong>Resumiendo:</strong> la proteína en polvo no es un suplemento mágico ni hace
          falta para ganar músculo. Es una herramienta cómoda para cuadrar dos comidas
          concretas. Si tu desayuno y tu merienda ya llevan proteína, no la necesitas.
        </div>
      </div>

      <!-- ─────────── ERRORES ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Errores</div>
        <h2 class="cs-title">Los dos errores que más gente abandona</h2>

        <h3 class="cs-h3">1. Comer siempre lo mismo</h3>
        <p class="cs-text">
          Es el motivo número uno por el que se abandona una dieta. No es falta de fuerza de
          voluntad: es <strong>aburrimiento</strong>. Nadie aguanta meses comiendo pollo con
          arroz todos los días.
        </p>
        <p class="cs-text">La solución es tener un menú abierto en vez de cerrado:</p>
        <div class="cs-highlight">
          <strong>Ten seis opciones para cada comida del día.</strong> Seis desayunos, seis
          comidas, seis meriendas, seis cenas. Con eso puedes ir jugando: si te has cansado
          de la pechuga con patata, la cambias por un filete de ternera y ajustas los gramos
          para que cuadren las calorías y la proteína.
        </div>
        <p class="cs-text">
          Así la dieta se adapta a ti en vez de al revés — y esa es la diferencia entre
          sostenerla seis meses o dejarla en tres semanas.
        </p>

        <h3 class="cs-h3">2. Calcular a ojo</h3>
        <p class="cs-text">
          «Yo ya sé más o menos lo que como». No. <strong>Calcular a ojo es la forma más
          habitual de creer que estás en déficit cuando no lo estás</strong>, y de ahí salen la
          mayoría de estancamientos que la gente atribuye al metabolismo.
        </p>
        <p class="cs-text">
          Pesa la comida con una báscula de cocina y mira la etiqueta, o busca el alimento con
          los gramos que has pesado. No hace falta hacerlo toda la vida: unas semanas bastan
          para calibrar el ojo. Pero al principio, pesa.
        </p>
      </div>

      <!-- ─────────── MITOS ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Mitos</div>
        <h2 class="cs-title">Dos mitos que conviene enterrar</h2>

        <h3 class="cs-h3">«Los carbohidratos engordan»</h3>
        <p class="cs-text">
          No. Lo que engorda es un <strong>superávit calórico mantenido en el tiempo</strong>,
          vengan las calorías de donde vengan.
        </p>
        <p class="cs-text">
          Si comes 3.000 kcal y gastas 2.500, engordas — den igual proteína o carbohidratos. Y
          si comes 2.300 y gastas 2.500, no engordas aunque la mayor parte de tu dieta sean
          carbohidratos. <strong>Es aritmética, no el tipo de alimento.</strong>
        </p>
        <p class="cs-text">
          Y si entrenas, los carbohidratos son la fuente de energía que más te conviene. No los
          elimines ni los bajes en exceso.
        </p>

        <h3 class="cs-h3">«Cuanta más proteína, menos músculo pierdes»</h3>
        <p class="cs-text">
          Tampoco. Pasado cierto punto, subir la proteína <strong>no añade nada</strong>: ni
          construyes más músculo ni lo proteges mejor. Es justo lo que encontró
          <a href={S.morton} target="_blank" rel="noopener">Morton et al. (2018)</a> a partir de
          1,6 g/kg.
        </p>
        <p class="cs-text">
          Lo que lo protege es <strong>entrenar fuerte y mantener las cargas</strong>. Si
          durante la definición sigues moviendo lo que movías —o mejorando—, mantienes el
          músculo. Si te obsesionas con la proteína a costa de los carbohidratos, pasa lo
          contrario: peores entrenamientos, peor descanso, peor recuperación, menos glucógeno.
          Y con menos fuerza, el músculo se va.
        </p>
      </div>

      <!-- ─────────── FAQ ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Preguntas frecuentes</div>
        <h2 class="cs-title">Preguntas frecuentes</h2>
        {
          faq.map((f) => (
            <div class="faq-item">
              <div class="faq-q">{f.p}</div>
              <div class="faq-a">{f.r}</div>
            </div>
          ))
        }
      </div>

      <Fuentes fuentes={fuentes} />

      <div class="content-section">
        <p class="cs-text">
          <strong>Siguiente paso:</strong> calcula tus
          <a href="/" style="color:var(--lime)">calorías y macros completos</a> para tener el
          reparto entero, no solo la proteína. Y si quieres saber cuánto músculo tienes ya,
          pasa por la <a href="/masa-muscular" style="color:var(--lime)">calculadora de FFMI</a>.
        </p>
        <p class="cs-text">
          ¿Vas a definir? Entonces te interesa
          <a href="/guias/deficit-calorico-como-calcularlo" style="color:var(--lime)">cómo
          calcular tu déficit calórico</a>: cuánto recortar, cómo saber si funciona y por qué
          casi nadie llega al final.
        </p>
      </div>
    </div>
  </main>
</Base>
