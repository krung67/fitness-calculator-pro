---
import Base from '../../layouts/Base.astro';
import Autoria from '../../components/Autoria.astro';
import Fuentes, { type Fuente } from '../../components/Fuentes.astro';
import { SITE } from '../../config/site';

// Guía piloto del formato «con fuentes» (septiembre de 2026). Regla: cada
// afirmación con cifra o conclusión científica enlaza a una fuente verificada
// (leída en su texto original, no en un resumen de buscador). Lo que no se
// pudo verificar se quitó en vez de buscarle cita después.
const ACTUALIZADO = '2026-09-11';

const S = {
  // Organismos de referencia
  aisA: 'https://www.ausport.gov.au/ais/nutrition/supplements/group_a',
  aisB: 'https://www.ausport.gov.au/ais/nutrition/supplements/group_b',
  aisC: 'https://www.ausport.gov.au/ais/nutrition/supplements/group_c',
  coi: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5867441/',
  acsm: 'https://www.dietitians.ca/DietitiansOfCanada/media/Documents/Resources/noap-position-paper.pdf?ext=.pdf',
  aesan: 'https://dialnet.unirioja.es/servlet/articulo?codigo=9734938',
  efsa: 'https://doi.org/10.2903/j.efsa.2010.1461',
  // Estudios y posturas de la ISSN
  issnCreatina: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5469049/',
  mitosCreatina: 'https://pubmed.ncbi.nlm.nih.gov/33557850/',
  rinon1998: 'https://pubmed.ncbi.nlm.nih.gov/9683235/',
  pelo2009: 'https://doi.org/10.1097/JSM.0b013e3181b8b52f',
  pelo2025: 'https://pubmed.ncbi.nlm.nih.gov/40265319/',
  issnProteina: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5477153/',
  morton: 'https://pubmed.ncbi.nlm.nih.gov/28698222/',
  tagawa: 'https://pubmed.ncbi.nlm.nih.gov/33300582/',
  omega3Dano: 'https://pubmed.ncbi.nlm.nih.gov/34760272/',
  vitaminas2026: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC12845069/',
  vitaminaD2015: 'https://pubmed.ncbi.nlm.nih.gov/25277808/',
  bcaa: 'https://pubmed.ncbi.nlm.nih.gov/28852372/',
  adelgazar: 'https://pubmed.ncbi.nlm.nih.gov/34159755/',
  glutamina: 'https://pubmed.ncbi.nlm.nih.gov/18806122/',
  cafeina: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7777221/',
  // Divulgación en español (no son fuentes primarias)
  fgCreatina: 'https://fitgeneration.es/como-tomar-creatina/',
  fgProteina: 'https://fitgeneration.es/cuanta-proteina-para-ganar-musculo/',
};

const fuentes: Fuente[] = [
  { autores: 'Maughan RJ, Burke LM, et al.', anio: 2018, titulo: 'IOC consensus statement: dietary supplements and the high-performance athlete', publicacion: 'British Journal of Sports Medicine (Comité Olímpico Internacional)', url: S.coi },
  { autores: 'Australian Institute of Sport', anio: 'consultado en septiembre de 2026', titulo: 'AIS Sports Supplement Framework: grupos A, B y C', publicacion: 'Australian Sports Commission', url: S.aisA },
  { autores: 'Thomas DT, Erdman KA, Burke LM', anio: 2016, titulo: 'Nutrition and Athletic Performance. Joint position of the Academy of Nutrition and Dietetics, Dietitians of Canada and the American College of Sports Medicine', publicacion: 'Medicine & Science in Sports & Exercise (texto publicado por Dietitians of Canada)', url: S.acsm },
  { autores: 'Comité Científico de la AESAN', anio: 2024, titulo: 'Informe en relación con el riesgo asociado al consumo de complementos alimenticios que contienen creatina como ingrediente', publicacion: 'Revista del Comité Científico de la AESAN, nº 39', url: S.aesan },
  { autores: 'Panel NDA de la EFSA', anio: 2010, titulo: 'Scientific Opinion on Dietary Reference Values for fats', publicacion: 'EFSA Journal', url: S.efsa },
  { autores: 'Kreider RB, et al.', anio: 2017, titulo: 'International Society of Sports Nutrition position stand: safety and efficacy of creatine supplementation in exercise, sport, and medicine', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.issnCreatina },
  { autores: 'Antonio J, et al.', anio: 2021, titulo: 'Common questions and misconceptions about creatine supplementation: what does the scientific evidence really show?', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.mitosCreatina },
  { autores: 'Pritchard NR, Kalra PA', anio: 1998, titulo: 'Renal dysfunction accompanying oral creatine supplements', publicacion: 'The Lancet', url: S.rinon1998 },
  { autores: 'van der Merwe J, et al.', anio: 2009, titulo: 'Three weeks of creatine monohydrate supplementation affects dihydrotestosterone to testosterone ratio in college-aged rugby players', publicacion: 'Clinical Journal of Sport Medicine', url: S.pelo2009 },
  { autores: 'Varios autores', anio: 2025, titulo: 'Does creatine cause hair loss? A 12-week randomized controlled trial', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.pelo2025 },
  { autores: 'Jäger R, et al.', anio: 2017, titulo: 'International Society of Sports Nutrition Position Stand: protein and exercise', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.issnProteina },
  { autores: 'Morton RW, et al.', anio: 2018, titulo: 'A systematic review, meta-analysis and meta-regression of the effect of protein supplementation on resistance training-induced gains in muscle mass and strength in healthy adults', publicacion: 'British Journal of Sports Medicine', url: S.morton },
  { autores: 'Tagawa R, et al.', anio: 2020, titulo: 'Dose-response relationship between protein intake and muscle mass increase: a systematic review and meta-analysis of randomized controlled trials', publicacion: 'Nutrition Reviews', url: S.tagawa },
  { autores: 'Xin G, et al.', anio: 2021, titulo: 'Effect of omega-3 fatty acids supplementation on indirect blood markers of exercise-induced muscle damage: systematic review and meta-analysis of randomized controlled trials', publicacion: 'Food Science & Nutrition', url: S.omega3Dano },
  { autores: 'Wiacek M, et al.', anio: 2026, titulo: 'Vitamin Supplementation in Sports: A Decade of Evidence-Based Insights', publicacion: 'Nutrients', url: S.vitaminas2026 },
  { autores: 'Farrokhyar F, et al.', anio: 2015, titulo: 'Prevalence of vitamin D inadequacy in athletes: a systematic-review and meta-analysis', publicacion: 'Sports Medicine', url: S.vitaminaD2015 },
  { autores: 'Wolfe RR', anio: 2017, titulo: 'Branched-chain amino acids and muscle protein synthesis in humans: myth or reality?', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.bcaa },
  { autores: 'Batsis JA, et al.', anio: 2021, titulo: 'A systematic review of dietary supplements and alternative therapies for weight loss', publicacion: 'Obesity', url: S.adelgazar },
  { autores: 'Gleeson M', anio: 2008, titulo: 'Dosing and efficacy of glutamine supplementation in human exercise and sport training', publicacion: 'The Journal of Nutrition', url: S.glutamina },
  { autores: 'Guest NS, et al.', anio: 2021, titulo: 'International Society of Sports Nutrition position stand: caffeine and exercise performance', publicacion: 'Journal of the International Society of Sports Nutrition', url: S.cafeina },
];

const faq = [
  {
    p: '¿Qué suplementos tienen de verdad respaldo científico?',
    r: 'Muy pocos. El consenso del Comité Olímpico Internacional (2018) concluye que solo unos pocos, entre ellos la cafeína y la creatina, tienen buena evidencia de beneficio. El Instituto Australiano del Deporte clasifica en su grupo A, el de evidencia sólida, la creatina, la cafeína, la proteína aislada y, para corregir carencias, la vitamina D y el hierro.',
  },
  {
    p: '¿Cuánta creatina hay que tomar al día?',
    r: 'La Sociedad Internacional de Nutrición Deportiva (ISSN, 2017) recomienda entre 3 y 5 gramos diarios de creatina monohidrato. En España, la AESAN (2024) considera segura y aceptable en complementos alimenticios una cantidad máxima de 3 g diarios de creatina para adultos sanos, equivalente a 3,41 g de monohidrato.',
  },
  {
    p: '¿Hay que hacer fase de carga con la creatina?',
    r: 'No es necesario. La carga (unos 0,3 g por kilo al día repartidos en varias tomas durante 5-7 días) llena antes los depósitos musculares, pero tomando 3 g al día se llega al mismo nivel en unas cuatro semanas, según la ISSN (2017).',
  },
  {
    p: '¿La creatina es mala para los riñones?',
    r: 'No hay evidencia de daño renal en personas sanas a las dosis recomendadas (Antonio et al., 2021). El miedo viene de un caso publicado en 1998 en The Lancet, de un paciente que ya tenía una enfermedad renal previa. Si tienes una patología renal diagnosticada, consúltalo con tu médico.',
  },
  {
    p: '¿La creatina hace caer el pelo?',
    r: 'La evidencia actual no lo respalda. El mito viene de un estudio de 2009 con 20 jugadores de rugby que midió una hormona, la DHT, pero no el pelo. En 2025, un ensayo aleatorizado de 12 semanas con 45 hombres que entrenaban sí midió el pelo y no encontró efectos ni en las hormonas ni en el pelo.',
  },
  {
    p: '¿Cuánta proteína al día necesito si entreno?',
    r: 'El ACSM y las asociaciones de dietistas de Estados Unidos y Canadá (2016) sitúan la ingesta de los deportistas entre 1,2 y 2,0 g por kilo al día, repartida en tomas de unos 0,3 g/kg cada 3-5 horas. Para ganar músculo, el metaanálisis de Morton et al. (2018) encontró que las ganancias dejan de aumentar hacia 1,6 g/kg.',
  },
  {
    p: '¿Cuánto omega 3 hay que tomar?',
    r: 'La EFSA fija una ingesta adecuada de 250 mg diarios de EPA y DHA para adultos. Para deportistas, el Instituto Australiano del Deporte lo sitúa en su grupo B: evidencia emergente o mixta. Un metaanálisis de 2021 encontró que reduce marcadores de daño muscular tras el ejercicio, con dosis que varían entre estudios.',
  },
  {
    p: '¿Sirven los multivitamínicos?',
    r: 'Solo si hay un déficit. El Instituto Australiano del Deporte los clasifica en el grupo B, y una revisión de 2026 concluye que la suplementación con vitaminas debe dirigirse a carencias confirmadas. La excepción frecuente es la vitamina D: un metaanálisis de 2015 encontró niveles inadecuados en el 56 % de los deportistas.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Suplementos que merecen la pena',
    description:
      'Creatina, proteína en polvo, omega 3 y multivitamínicos según el Comité Olímpico Internacional, el Instituto Australiano del Deporte, la AESAN y los estudios más recientes.',
    inLanguage: 'es-ES',
    author: { '@id': `${SITE.url}/#persona` },
    publisher: { '@id': `${SITE.url}/#persona` },
    mainEntityOfPage: `${SITE.url}/guias/suplementos-que-merecen-la-pena`,
    dateModified: ACTUALIZADO,
    citation: fuentes.map((f) => f.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.p,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guías', item: `${SITE.url}/guias` },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Suplementos que merecen la pena',
        item: `${SITE.url}/guias/suplementos-que-merecen-la-pena`,
      },
    ],
  },
];
---

<Base
  title="Suplementos: Cuáles Merecen la Pena de Verdad"
  description="Creatina, proteína, omega 3 y multivitamínicos según el Comité Olímpico, el Instituto Australiano del Deporte, la AESAN y los estudios más recientes."
  schema={schema}
>
  <div class="hero hero-sm">
    <div class="hero-glow"></div>
    <div class="site-badge">Guía</div>
    <h1>Suplementos que merecen la pena</h1>
    <p class="hero-sub">
      Qué dicen hoy los organismos de referencia y los estudios sobre creatina, proteína, omega 3
      y vitaminas, qué se creía antes y de dónde sale cada dato.
    </p>
  </div>

  <main id="contenido">
    <div class="wrap">
      <div class="content-section" style="border-top:none;padding-top:2.5rem">
        <Autoria actualizado={ACTUALIZADO} />
        <p class="cs-text">
          Entras en una tienda de suplementos y hay doscientos productos. La realidad es más
          aburrida: <strong>hay muy pocos con respaldo científico sólido</strong>, y de esos,
          algunos son simplemente comida en formato cómodo.
        </p>
        <p class="cs-text">
          Ninguno compensa dormir poco, entrenar sin progresión o no llegar a tus calorías. Si no
          sabes tus cifras, empieza por la <a href="/">calculadora de calorías y macros</a>.
        </p>
      </div>

      <!-- ─────────── ORGANISMOS DE REFERENCIA ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Quién lo dice</div>
        <h2 class="cs-title">Lo que dicen los organismos de referencia</h2>
        <p class="cs-text">
          Antes que estudios sueltos, conviene mirar a quien revisa toda la evidencia. El
          <a href={S.coi} target="_blank" rel="noopener">consenso del Comité Olímpico Internacional
          (2018)</a> concluye que, de todos los productos que se venden para mejorar el
          rendimiento, <strong>solo unos pocos —entre ellos la cafeína y la creatina— tienen buena
          evidencia de beneficio</strong>.
        </p>
        <p class="cs-text">
          El Instituto Australiano del Deporte (AIS) va más allá y clasifica cada suplemento según la
          evidencia. Así quedan los de esta guía:
        </p>
        <table class="tabla-legal">
          <thead>
            <tr><th>Grupo del AIS</th><th>Qué significa</th><th>Suplementos de esta guía</th></tr>
          </thead>
          <tbody>
            <tr>
              <td><a href={S.aisA} target="_blank" rel="noopener"><strong>A</strong></a></td>
              <td>Evidencia científica sólida</td>
              <td>Creatina, cafeína, proteína aislada; vitamina D y hierro para corregir carencias</td>
            </tr>
            <tr>
              <td><a href={S.aisB} target="_blank" rel="noopener"><strong>B</strong></a></td>
              <td>Evidencia emergente o mixta</td>
              <td>Omega 3, multivitamínico</td>
            </tr>
            <tr>
              <td><a href={S.aisC} target="_blank" rel="noopener"><strong>C</strong></a></td>
              <td>La evidencia no respalda su beneficio</td>
              <td>BCAA (bajaron del grupo B al C)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- ─────────── CREATINA ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Grupo A del AIS</div>
        <h2 class="cs-title">Cuánta creatina tomar al día</h2>
        <p class="cs-text">
          La creatina es el suplemento con más investigación de la nutrición deportiva. La
          <a href={S.issnCreatina} target="_blank" rel="noopener">postura oficial de la ISSN
          (2017)</a> la considera eficaz y segura, y resume así cómo tomarla:
        </p>
        <table class="tabla-legal">
          <thead>
            <tr><th>Qué</th><th>Cuánto</th><th>Detalle</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Dosis diaria</strong></td><td>3-5 g</td><td>Todos los días</td></tr>
            <tr><td><strong>Deportistas grandes</strong></td><td>5-10 g</td><td>Mucho peso y entrenamiento muy intenso</td></tr>
            <tr><td><strong>Fase de carga</strong></td><td>Opcional</td><td>~0,3 g/kg/día, 5-7 días</td></tr>
            <tr><td><strong>Sin carga</strong></td><td>3 g/día</td><td>Mismo nivel en ~4 semanas</td></tr>
          </tbody>
        </table>

        <h3 class="cs-h3">En España: lo que dice la AESAN</h3>
        <p class="cs-text">
          La Agencia Española de Seguridad Alimentaria y Nutrición publicó en 2024 un
          <a href={S.aesan} target="_blank" rel="noopener">informe de su Comité Científico</a> que
          considera segura y aceptable en complementos alimenticios una cantidad máxima de
          <strong>3 g diarios de creatina para adultos sanos</strong>, equivalente a 3,41 g de
          monohidrato. El propio informe limita su valoración a adultos sanos.
        </p>
        <div class="cs-highlight">
          <strong>¿Entonces 3 o 5 gramos?</strong> No se contradicen: los 3 g de la AESAN son el
          límite que evalúa para complementos alimenticios en España, y los 3-5 g de la ISSN salen de
          los estudios en deportistas. Con 3 g al día estás dentro de las dos recomendaciones. Si
          tienes menos de 18 años, estás embarazada o tienes alguna patología, consúltalo antes con
          un profesional.
        </div>

        <h3 class="cs-h3">Monohidrato, y el sello Creapure®</h3>
        <p class="cs-text">
          La <a href={S.mitosCreatina} target="_blank" rel="noopener">revisión de mitos de Antonio
          et al. (2021)</a> concluye que ninguna de las formas «avanzadas» —clorhidrato, tamponada,
          éster etílico— ha demostrado ser mejor que el monohidrato, que además es la más barata.
        </p>
        <p class="cs-text">
          Si puedes, elige un bote con el sello
          <a href="https://www.creapure.com/en/creapure/the-creapure-quality-seal/" target="_blank" rel="noopener">Creapure®</a>:
          monohidrato fabricado en Alemania, con un 99,9 % de pureza y cada lote analizado. No hace
          más efecto; lo que compras es la garantía de que el bote lleva lo que pone. Si compites
          con control antidopaje, importa de verdad.
        </p>

        <h3 class="cs-h3">Tres mitos: lo que se creía y lo que se sabe hoy</h3>

        <div class="antes-ahora">
          <div class="aa-antes">
            <div class="aa-etq">Riñones · lo que se creía</div>
            <p>
              En 1998, <a href={S.rinon1998} target="_blank" rel="noopener">un caso publicado en
              The Lancet</a> relacionó la creatina con un problema renal. El paciente ya tenía una
              enfermedad renal previa.
            </p>
          </div>
          <div class="aa-ahora">
            <div class="aa-etq">Riñones · lo que se sabe hoy</div>
            <p>
              A las dosis recomendadas no daña el riñón en personas sanas
              (<a href={S.mitosCreatina} target="_blank" rel="noopener">Antonio et al., 2021</a>).
              La ISSN recoge dosis de hasta 30 g diarios durante 5 años sin efectos perjudiciales.
            </p>
          </div>
        </div>

        <div class="antes-ahora">
          <div class="aa-antes">
            <div class="aa-etq">Pelo · lo que se creía</div>
            <p>
              Todo sale de <a href={S.pelo2009} target="_blank" rel="noopener">un estudio de
              2009</a> con 20 jugadores de rugby: la DHT, una hormona relacionada con la calvicie,
              subió. Pero <strong>no midieron el pelo</strong>.
            </p>
          </div>
          <div class="aa-ahora">
            <div class="aa-etq">Pelo · lo que se sabe hoy</div>
            <p>
              En 2025, <a href={S.pelo2025} target="_blank" rel="noopener">un ensayo aleatorizado
              de 12 semanas</a> con 45 hombres que entrenaban, con 5 g diarios, sí midió el pelo:
              ningún efecto ni en las hormonas ni en el pelo.
            </p>
          </div>
        </div>

        <div class="antes-ahora">
          <div class="aa-antes">
            <div class="aa-etq">Retención de líquidos · lo que se creía</div>
            <p>Que la creatina «hincha» siempre y tapa la definición.</p>
          </div>
          <div class="aa-ahora">
            <div class="aa-etq">Retención de líquidos · lo que se sabe hoy</div>
            <p>
              No siempre provoca retención de agua
              (<a href={S.mitosCreatina} target="_blank" rel="noopener">Antonio et al., 2021</a>).
              Si ves algo más de peso las primeras semanas, no es grasa.
            </p>
          </div>
        </div>

        <p class="cs-text">
          Y no hace falta hacer ciclos: la misma revisión no encuentra evidencia de que parar cada
          cierto tiempo sea necesario.
        </p>
      </div>

      <!-- ─────────── PROTEÍNA ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Grupo A del AIS · es comida</div>
        <h2 class="cs-title">Cuánta proteína en polvo tomar</h2>
        <p class="cs-text">
          La proteína en polvo no tiene ningún efecto especial: es proteína, como la de un filete.
          La pregunta útil es <strong>cuánta proteína necesitas al día en total</strong>, y el polvo
          solo cubre lo que no llegues con la comida.
        </p>

        <div class="antes-ahora">
          <div class="aa-antes">
            <div class="aa-etq">Lo que se repetía en el gimnasio</div>
            <p>Que para ganar músculo hacían falta 2 g de proteína por kilo como mínimo, y que cuanta más, mejor.</p>
          </div>
          <div class="aa-ahora">
            <div class="aa-etq">Lo que muestran los estudios</div>
            <p>
              Casi todo el beneficio llega antes. Según <a href={S.tagawa} target="_blank" rel="noopener">Tagawa
              et al. (2020)</a>, cada 0,1 g/kg más se asoció con +0,39 kg de masa magra por debajo de
              1,3 g/kg al día, y solo con +0,12 kg por encima.
            </p>
          </div>
        </div>

        <ul class="cs-lista">
          <li>
            El <a href={S.acsm} target="_blank" rel="noopener">ACSM y las asociaciones de dietistas de
            Estados Unidos y Canadá (2016)</a> sitúan la ingesta de los deportistas entre
            <strong>1,2 y 2,0 g por kilo al día</strong>, repartida en tomas de unos 0,3 g/kg cada
            3-5 horas.
          </li>
          <li>
            La <a href={S.issnProteina} target="_blank" rel="noopener">ISSN (2017)</a> la sitúa en
            <strong>1,4-2,0 g/kg</strong> para la mayoría de personas que hacen ejercicio.
          </li>
          <li>
            Para ganar músculo, el <a href={S.morton} target="_blank" rel="noopener">metaanálisis de
            Morton et al. (2018)</a>, con 49 estudios y 1.863 personas, encontró que las ganancias
            dejan de aumentar hacia <strong>1,6 g/kg</strong>, con un techo razonable en torno a
            2,2 g/kg.
          </li>
        </ul>
        <p class="cs-text">
          Donde el polvo ayuda de verdad es en desayunos y meriendas, donde cuesta llegar a esa toma
          de proteína sin recurrir a platos salados. Tienes cómo repartirla en
          <a href="/guias/proteina-de-los-alimentos">proteína de los alimentos</a>.
        </p>
      </div>

      <!-- ─────────── OMEGA 3 ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Grupo B del AIS</div>
        <h2 class="cs-title">Cuánto omega 3 hace falta</h2>
        <p class="cs-text">
          La <a href={S.efsa} target="_blank" rel="noopener">EFSA</a>, la autoridad europea de
          seguridad alimentaria, fija una <strong>ingesta adecuada de 250 mg diarios de EPA y
          DHA</strong> para adultos.
        </p>
        <p class="cs-text">
          Para deportistas, el AIS lo deja en el grupo B: evidencia emergente o mixta. Un
          <a href={S.omega3Dano} target="_blank" rel="noopener">metaanálisis de 2021</a> encontró que
          la suplementación reduce marcadores de daño muscular en sangre tras el ejercicio, pero las
          dosis cambian mucho de un estudio a otro, así que no hay una cifra única.
        </p>
        <div class="cs-highlight">
          <strong>Mira la etiqueta bien.</strong> Lo que cuenta son los miligramos de
          <strong>EPA y DHA</strong> por cápsula, no el peso total de aceite que anuncia el bote.
        </div>
      </div>

      <!-- ─────────── VITAMINAS ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Grupo B del AIS · solo si falta algo</div>
        <h2 class="cs-title">¿Sirven los multivitamínicos?</h2>
        <p class="cs-text">
          Una <a href={S.vitaminas2026} target="_blank" rel="noopener">revisión de 2026</a> sobre
          diez años de estudios en deportistas concluye que la suplementación con vitaminas debe
          <strong>dirigirse a carencias confirmadas</strong>. Con una dieta equilibrada, tomar de
          más no aporta beneficios.
        </p>
        <h3 class="cs-h3">La excepción frecuente: la vitamina D</h3>
        <p class="cs-text">
          A diferencia del multivitamínico, la vitamina D está en el grupo A del AIS, para corregir
          carencias. Un <a href={S.vitaminaD2015} target="_blank" rel="noopener">metaanálisis de
          2015</a> encontró niveles inadecuados en el <strong>56 % de los deportistas</strong>, con
          más riesgo en deportes de interior y en latitudes altas. La revisión de 2026 da cifras
          parecidas, más altas en invierno.
        </p>
        <div class="cs-highlight">
          <strong>Lo sensato:</strong> un análisis de sangre antes que un bote. Suplementar a ciegas
          es adivinar pagando.
        </div>
      </div>

      <!-- ─────────── LO QUE NO ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Ahórrate el dinero</div>
        <h2 class="cs-title">Lo que no merece la pena</h2>
        <p class="cs-text">
          <strong>BCAA.</strong> El AIS los bajó al grupo C, y la revisión de
          <a href={S.bcaa} target="_blank" rel="noopener">Wolfe (2017)</a> concluye que la idea de
          que los BCAA por sí solos estimulan la síntesis de músculo no está justificada. Si llegas
          a tu proteína del día, ya los estás comiendo.
        </p>
        <p class="cs-text">
          <strong>Quemagrasas.</strong> Una <a href={S.adelgazar} target="_blank" rel="noopener">revisión
          sistemática de 2021</a> que analizó 315 ensayos concluye que no hay evidencia suficiente
          para recomendar ningún suplemento para adelgazar por sí solo. Lo que quema grasa es el
          <a href="/guias/deficit-calorico-como-calcularlo">déficit calórico</a>.
        </p>
        <p class="cs-text">
          <strong>Glutamina.</strong> La <a href={S.glutamina} target="_blank" rel="noopener">revisión
          de Gleeson (2008)</a> concluye que la evidencia no es lo bastante sólida para recomendarla
          a deportistas.
        </p>
        <p class="cs-text">
          <strong>Preentrenos, con matices.</strong> Lo que funciona de ellos suele ser la cafeína,
          que está en el grupo A: la <a href={S.cafeina} target="_blank" rel="noopener">ISSN
          (2021)</a> sitúa la dosis eficaz en 3-6 mg por kilo, en torno a una hora antes de
          entrenar. Un café hace lo mismo por mucho menos dinero.
        </p>
      </div>

      <!-- ─────────── RESUMEN ─────────── -->
      <div class="content-section">
        <div class="cs-tag">Resumen</div>
        <h2 class="cs-title">Si solo te vas a llevar una cosa</h2>
        <table class="tabla-legal">
          <thead>
            <tr><th>Suplemento</th><th>AIS</th><th>¿Merece la pena?</th><th>Según la evidencia</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Creatina monohidrato</strong></td><td>A</td><td>✅ Sí</td><td>3 g (AESAN) · 3-5 g (ISSN)</td></tr>
            <tr><td><strong>Proteína en polvo</strong></td><td>A</td><td>✅ Si no llegas comiendo</td><td>Referencia: 1,6 g/kg al día</td></tr>
            <tr><td><strong>Omega 3</strong></td><td>B</td><td>⚠️ Según tu dieta</td><td>250 mg EPA+DHA (EFSA)</td></tr>
            <tr><td><strong>Multivitamínico</strong></td><td>B</td><td>⚠️ Solo con déficit</td><td>Análisis primero</td></tr>
            <tr><td><strong>BCAA</strong></td><td>C</td><td>❌ No</td><td>—</td></tr>
          </tbody>
        </table>
        <p class="cs-text">
          Y lo que de verdad mueve la aguja es la comida del día a día: puedes montarla con el
          <a href="/generador-dieta">generador de dieta</a>.
        </p>
      </div>

      <!-- ─────────── FAQ ─────────── -->
