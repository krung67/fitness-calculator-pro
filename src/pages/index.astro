<!-- is:inline evita que Astro convierta esto en un módulo ES.
     Sin este atributo las funciones dejarían de ser globales
     y todos los onclick del HTML fallarían en silencio. -->
<script is:inline>
const D={bmr:null,mant:null,obj:null,tipo:null,prot:null,grasa:null,carb:null};

function goStep(n){
  document.querySelectorAll('.panel').forEach((p,i)=>p.classList.toggle('active',i===n));
  document.querySelectorAll('.srail-btn').forEach((b,i)=>{
    b.classList.toggle('active',i===n);
  });
  // Son 4 pasos de cálculo; el 5º panel es el resumen. La barra llega al
  // 100% al completar el paso 4 y se queda ahí, en vez de tratar el
  // resumen como un quinto paso pendiente.
  const PASOS=4;
  document.getElementById('progFill').style.width=(Math.min(n+1,PASOS)/PASOS*100)+'%';
  window.scrollTo({top:0,behavior:'smooth'});
}

function calcBMR(){
  const edad=parseInt(document.getElementById('edad').value);
  const peso=parseFloat(document.getElementById('peso').value);
  const altura=parseFloat(document.getElementById('altura').value);
  const sexo=document.getElementById('sexo').value;
  if(!edad||!peso||!altura||!sexo){alert('Completa todos los campos');return}
  const bmr=Math.round(sexo==='h'?(10*peso+6.25*altura-5*edad+5):(10*peso+6.25*altura-5*edad-161));
  D.bmr=bmr;
  document.getElementById('v0').textContent=bmr+' kcal/día';
  document.getElementById('d0').textContent='Calorías mínimas que tu cuerpo necesita en reposo absoluto.';
  document.getElementById('tip1').textContent='BMR detectado: '+bmr+' kcal — ahora selecciona tu nivel de actividad.';
  show('r0');show('n0');
  document.querySelectorAll('.srail-btn')[0].classList.add('done');
}

function calcMant(){
  if(!D.bmr){alert('Calcula primero tu BMR en el paso 1');return}
  const act=parseFloat(document.getElementById('actividad').value);
  if(!act){alert('Selecciona tu nivel de actividad');return}
  const mant=Math.round(D.bmr*act);
  D.mant=mant;
  const labels={1.2:'Sedentario',1.375:'Actividad ligera',1.55:'Actividad moderada',1.725:'Actividad alta',1.9:'Muy activo'};
  document.getElementById('v1').textContent=mant+' kcal/día';
  document.getElementById('d1').textContent=labels[act]+' · Con estas calorías tu peso permanece estable.';
  document.getElementById('tip2').textContent='Mantenimiento: '+mant+' kcal. Ahora elige tu objetivo.';
  show('r1');show('n1');
  document.querySelectorAll('.srail-btn')[1].classList.add('done');
}

function calcObj(){
  if(!D.mant){alert('Calcula primero tu mantenimiento');return}
  const obj=document.getElementById('objetivo').value;
  if(!obj){alert('Selecciona tu objetivo');return}
  let cal,desc,label;
  if(obj==='def'){cal=Math.round(D.mant-400);desc='Déficit de 400 kcal/día · Pérdida gradual y sostenible (~0.3–0.5 kg/semana).';label='Definición'}
  else if(obj==='vol'){cal=Math.round(D.mant+300);desc='Superávit de 300 kcal/día · Volumen limpio para ganar masa muscular sin acumular grasa.';label='Volumen'}
  else{cal=D.mant;desc='Calorías de mantenimiento · Ideal para recomposición corporal.';label='Mantenimiento'}
  D.obj=cal;D.tipo=label;
  document.getElementById('rl2').textContent=label;
  document.getElementById('v2').textContent=cal+' kcal/día';
  document.getElementById('d2').textContent=desc;
  document.getElementById('tip3').textContent='Objetivo '+label.toLowerCase()+': '+cal+' kcal. Calculando macros óptimos...';
  show('r2');show('n2');
  document.querySelectorAll('.srail-btn')[2].classList.add('done');
}

function calcMacros(){
  if(!D.obj){alert('Completa los pasos anteriores primero');return}
  const peso=parseFloat(document.getElementById('peso').value)||70;
  const obj=document.getElementById('objetivo').value||'mant';
  const act=parseFloat(document.getElementById('actividad').value)||1.2;
  let pKg,gKg,alerta;
  if(act<=1.2){
    pKg=2.0;gKg=1.0;
    alerta='⚠️ Perfil sedentario: priorizamos proteína y grasa porque sin actividad física regular tu cuerpo no demanda glucosa de forma intensa. Los carbohidratos altos en este contexto se almacenan más fácilmente como grasa. Este cálculo se ajusta automáticamente según tu nivel de actividad.';
  } else if(act<=1.375){
    pKg=1.8;gKg=0.9;
    alerta='⚠️ Actividad ligera: carbohidratos moderadamente bajos. Tu cuerpo usa algo de glucosa pero no en grandes cantidades. Proteína y grasa siguen siendo prioritarias. Este cálculo se adapta a tu nivel de actividad.';
  } else if(act<=1.55){
    pKg=1.4;gKg=0.7;
    alerta='✅ Actividad moderada: equilibrio entre los tres macros. Empiezas a necesitar más carbohidratos como combustible para tus entrenamientos. Los macros se ajustan a tu nivel de actividad.';
  } else {
    if(obj==='def'){pKg=1.2;gKg=0.5}
    else if(obj==='vol'){pKg=1.6;gKg=0.8}
    else{pKg=1.4;gKg=0.6}
    alerta='🔥 Alta actividad: carbohidratos altos para reponer el glucógeno muscular. Tu cuerpo los necesita y los utiliza eficientemente. Los macros se ajustan también según tu objetivo (déficit / mantenimiento / volumen).';
  }
  const alertaEl=document.getElementById('macroAlerta');
  alertaEl.textContent=alerta;alertaEl.style.display='block';
  const prot=Math.round(peso*pKg);
  const gras=Math.round(peso*gKg);
  const calP=prot*4,calG=gras*9;
  const calC=Math.max(0,D.obj-calP-calG);
  const carb=Math.round(calC/4);
  D.prot=prot;D.grasa=gras;D.carb=carb;
  const g=v=>v+'g';
  document.getElementById('mp').textContent=g(prot);
  document.getElementById('mg').textContent=g(gras);
  document.getElementById('mc').textContent=g(carb);
  document.getElementById('mpc').textContent=calP+' kcal';
  document.getElementById('mgc').textContent=calG+' kcal';
  document.getElementById('mcc').textContent=Math.round(calC)+' kcal';
  document.getElementById('macRow').classList.add('show');
  show('n3');
  document.querySelectorAll('.srail-btn')[3].classList.add('done');
  syncResumen();
}

function syncResumen(){
  if(!D.bmr)return;
  document.getElementById('sb').textContent=D.bmr||'—';
  document.getElementById('sm').textContent=D.mant||'—';
  document.getElementById('so').textContent=D.obj||'—';
  document.getElementById('st').textContent=D.tipo||'—';
  if(D.prot){
    const g=v=>v+'g';
    document.getElementById('smp').textContent=g(D.prot);
    document.getElementById('smg').textContent=g(D.grasa);
    document.getElementById('smc').textContent=g(D.carb);
    document.getElementById('smpc').textContent=D.prot*4+' kcal';
    document.getElementById('smgc').textContent=D.grasa*9+' kcal';
    document.getElementById('smcc').textContent=Math.round(D.obj-D.prot*4-D.grasa*9)+' kcal';
    const peso=parseFloat(document.getElementById('peso').value)||'?';
    document.getElementById('sumTip').textContent='Plan calculado para '+peso+'kg. Recalcula cada mes o cuando tu peso cambie más de 3 kg.';
    document.querySelectorAll('.srail-btn')[4].classList.add('done');
  }
}

function guardar(){
  if(!D.bmr){alert('Calcula tus datos primero');return}
  let hist=JSON.parse(localStorage.getItem('cfhist'))||[];
  const entry={
    fecha:new Date().toLocaleString('es-ES'),
    bmr:D.bmr,mant:D.mant,obj:D.obj,tipo:D.tipo,
    prot:D.prot,grasa:D.grasa,carb:D.carb,
    peso:parseFloat(document.getElementById('peso').value)||null
  };
  hist.unshift(entry);
  if(hist.length>10)hist=hist.slice(0,10);
  localStorage.setItem('cfhist',JSON.stringify(hist));
  renderHist();
  goStep(4);
  alert('✅ Guardado en tu historial');
}

function borrarHistorial(){
  if(confirm('¿Seguro que quieres borrar todo el historial?')){
    localStorage.removeItem('cfhist');renderHist();
  }
}

function renderHist(){
  const hist=JSON.parse(localStorage.getItem('cfhist'))||[];
  const c=document.getElementById('histContainer');
  const b=document.getElementById('btnBorrar');
  if(hist.length===0){
    c.innerHTML='<div class="hist-empty">Aún no tienes cálculos guardados. Completa los 4 pasos y pulsa "Guardar en historial".</div>';
    b.style.display='none';return;
  }
  b.style.display='block';
  c.innerHTML=hist.map(h=>`
    <div class="hist-entry">
      <div class="hist-date">${h.fecha}${h.peso?' · '+h.peso+' kg':''}</div>
      <div class="hist-row">
        <span class="hist-chip">BMR <strong>${h.bmr}</strong> kcal</span>
        <span class="hist-chip">Mant. <strong>${h.mant}</strong> kcal</span>
        <span class="hist-chip">Obj. <strong>${h.obj}</strong> kcal</span>
        ${h.tipo?`<span class="hist-chip"><strong>${h.tipo}</strong></span>`:''}
        ${h.prot?`<span class="hist-chip">P <strong>${h.prot}g</strong> G <strong>${h.grasa}g</strong> C <strong>${h.carb}g</strong></span>`:''}
      </div>
    </div>`).join('');
}

function descargarPlan(){
  if(!D.bmr||!D.obj){alert('Completa los pasos anteriores para poder descargar tu plan');return}

  const val=id=>document.getElementById(id).value;
  const texto=id=>{
    const s=document.getElementById(id);
    return s.options[s.selectedIndex] ? s.options[s.selectedIndex].text : '—';
  };
  const fila=(k,v)=>`<tr><th>${k}</th><td>${v}</td></tr>`;

  document.getElementById('hpFecha').textContent=new Date().toLocaleDateString('es-ES',{
    day:'numeric',month:'long',year:'numeric'
  });

  document.getElementById('hpDatos').innerHTML=
    fila('Edad',val('edad')+' años')+
    fila('Sexo',texto('sexo'))+
    fila('Peso',val('peso')+' kg')+
    fila('Altura',val('altura')+' cm')+
    fila('Nivel de actividad',texto('actividad'))+
    fila('Objetivo',texto('objetivo'));

  document.getElementById('hpCalorias').innerHTML=
    fila('Metabolismo basal (BMR)','<strong>'+D.bmr+'</strong> kcal/día')+
    fila('Mantenimiento (TDEE)','<strong>'+D.mant+'</strong> kcal/día')+
    fila('Objetivo — '+D.tipo,'<strong>'+D.obj+'</strong> kcal/día');

  // Los macros solo salen si se calcularon: mejor omitir la sección que
  // imprimir guiones que parezcan un error.
  const secMacros=document.getElementById('hpMacros').closest('.hp-seccion');
  if(D.prot){
    const carbKcal=Math.round(D.obj-D.prot*4-D.grasa*9);
    document.getElementById('hpMacros').innerHTML=
      fila('Proteína','<strong>'+D.prot+' g</strong> · '+(D.prot*4)+' kcal')+
      fila('Grasas','<strong>'+D.grasa+' g</strong> · '+(D.grasa*9)+' kcal')+
      fila('Carbohidratos','<strong>'+D.carb+' g</strong> · '+carbKcal+' kcal');
    secMacros.style.display='';
  } else {
    secMacros.style.display='none';
  }

  document.getElementById('hpNota').innerHTML=
    '<strong>Recalcula cada 4-6 semanas</strong>, o cuando tu peso cambie más de 3 kg. '+
    'Al perder grasa o ganar músculo, tus necesidades calóricas cambian: no actualizarlas '+
    'es una de las causas más comunes de estancamiento.';

  window.print();
}

function resetAll(){
  if(!confirm('¿Resetear todos los datos?'))return;
  Object.keys(D).forEach(k=>D[k]=null);
  ['edad','peso','altura'].forEach(id=>{document.getElementById(id).value=''});
  ['sexo','actividad','objetivo'].forEach(id=>{document.getElementById(id).value=''});
  ['r0','r1','r2','n0','n1','n2','n3'].forEach(id=>{document.getElementById(id).classList.remove('show')});
  document.getElementById('macRow').classList.remove('show');
  document.getElementById('tip1').textContent='Calcula primero tu BMR en el paso anterior.';
  document.getElementById('tip2').textContent='Selecciona qué quieres conseguir con tu alimentación.';
  document.getElementById('tip3').textContent='Se calcularán automáticamente en base a tu peso y objetivo.';
  document.getElementById('macroAlerta').style.display='none';
  document.getElementById('sumTip').textContent='Completa los pasos anteriores para ver tu resumen.';
  document.querySelectorAll('.srail-btn').forEach(b=>b.classList.remove('done'));
  goStep(0);
}

function show(id){document.getElementById(id).classList.add('show')}

renderHist();
</script>
